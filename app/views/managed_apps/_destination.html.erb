<div class="rounded-lg border border-neutral-800 p-4">
  <header class="mb-3 flex items-center justify-between">
    <h2 class="font-medium text-neutral-100"><%= destination.name || "base" %></h2>
    <span class="text-xs text-neutral-500"><%= destination.config_file %></span>
  </header>

  <%# Servers/accessories are covered live (with state) below by destination_status —
      listing them again here as static config would just be the same names twice. %>
  <dl class="mb-4 grid grid-cols-[auto_1fr] gap-x-3 gap-y-1 text-sm">
    <dt class="text-neutral-500">SSH user</dt>
    <dd class="text-neutral-300"><%= destination.ssh_user.presence || "default" %></dd>

    <dt class="text-neutral-500">Proxy host</dt>
    <dd class="text-neutral-300"><%= destination.proxy_host.presence || "none" %></dd>
  </dl>

  <%= render "managed_apps/destination_status", app_destination: destination %>
</div>
