<%= turbo_frame_tag dom_id(managed_app) do %>
  <div class="flex flex-col gap-3 rounded-lg border border-neutral-800 bg-neutral-900 p-4">
    <header class="flex items-start justify-between gap-2">
      <div>
        <h2 class="text-lg font-medium text-neutral-100"><%= managed_app.display_label %></h2>
        <p class="text-sm text-neutral-500"><%= managed_app.service_name %></p>
      </div>
      <span class="mt-1 h-3 w-3 shrink-0 rounded-full <%= status_dot_color(managed_app.status_rollup) %>"
            title="<%= status_label(managed_app.status_rollup) %>"></span>
    </header>

    <div class="flex flex-col gap-1.5">
      <% if managed_app.app_destinations.empty? %>
        <p class="text-sm italic text-neutral-600">No destinations found on last scan.</p>
      <% else %>
        <% managed_app.app_destinations.each do |destination| %>
          <% status = destination.destination_status %>
          <% pill_text = capture do %>
            <%= destination.name || "base" %>
            <% if status.nil? %>
              &middot; <%= status_label("unknown") %>
            <% else %>
              <% if (versions = deployed_versions(status)).any? %>
                &middot; <%= short_sha(versions.first) %>
              <% end %>
              <% if (summary = role_summary(destination)) %>
                &middot; <%= summary %>
              <% end %>
            <% end %>
          <% end %>
          <%= render "managed_apps/status_pill", state: status&.state || "unknown", text: pill_text, title: status&.error %>
        <% end %>
      <% end %>
    </div>

    <p class="text-xs text-neutral-500"><%= staleness_in_words(managed_app_checked_at(managed_app)) %></p>

    <details class="text-sm">
      <summary class="cursor-pointer text-neutral-400 hover:text-neutral-200">Rename</summary>
      <%= render "managed_apps/rename_form", managed_app: managed_app %>
    </details>

    <footer class="flex items-center justify-between border-t border-neutral-800 pt-3">
      <%= link_to "View", managed_app_path(managed_app),
            data: { turbo_frame: "_top" }, class: "text-sm text-neutral-400 hover:text-neutral-200" %>
      <%= button_to "Forget", managed_app_path(managed_app), method: :delete,
            data: { turbo_frame: "_top", turbo_confirm: "Forget #{managed_app.display_label}? This can't be undone." },
            class: "text-sm text-red-500 hover:text-red-400" %>
    </footer>
  </div>
<% end %>
