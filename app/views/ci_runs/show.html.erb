<% content_for :title, @run ? "CI · #{@run.app}" : "CI run" %>

<% if @run&.live? %>
  <%# The follower ends with a refresh: morph it in place so the log keeps its scroll. %>
  <% content_for :head do %>
    <meta name="turbo-refresh-method" content="morph">
    <meta name="turbo-refresh-scroll" content="preserve">
  <% end %>
  <%= turbo_stream_from Kamander::Ci::LogFollower.stream_name(@run.id) %>
<% end %>

<section class="w-full">
  <%= link_to "← CI", ci_runs_path, class: "text-sm text-neutral-400 hover:text-neutral-200" %>

  <% if @run.nil? %>
    <p role="alert" class="mt-4 rounded-md border border-red-900 bg-red-950/40 px-4 py-2 text-sm text-red-300">
      CI box unreachable: <%= @listing.error %>
    </p>
  <% else %>
    <header class="mt-2 mb-6 flex flex-wrap items-center gap-3">
      <h1 class="text-xl font-semibold text-neutral-100"><%= @run.app %></h1>
      <%= ci_state_pill(@run) %>
      <span class="font-mono text-xs text-neutral-400"><%= @run.branch %> &middot; <%= @run.short_sha %></span>
      <% if @run.dry_run %><span class="rounded bg-neutral-800 px-1 text-xs text-neutral-300">dry run</span><% end %>
      <span class="text-sm text-neutral-500"><%= ci_duration(@run.duration) %></span>
    </header>

    <% if @run.steps.any? %>
      <table class="mb-6 text-sm">
        <tbody>
          <% @run.steps.each do |step| %>
            <tr>
              <td class="py-1 pr-6"><%= ci_step_pill(step) %></td>
              <td class="py-1 text-neutral-500"><%= step.took %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>

    <h2 class="mb-2 text-sm font-medium text-neutral-400">Log <span class="font-normal text-neutral-600">(last <%= Kamander::Ci::RunReader::LOG_LINES %> lines)</span></h2>
    <% if @log || @run.live? %>
      <pre id="ci_run_log" class="max-h-[70vh] overflow-auto rounded-md border border-neutral-800 bg-black p-3 font-mono text-xs leading-relaxed text-neutral-300"><%= @log %></pre>
    <% else %>
      <p class="text-sm italic text-neutral-500">Log unavailable.</p>
    <% end %>
  <% end %>
</section>
