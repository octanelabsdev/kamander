<%= turbo_frame_tag :latest_ci, class: "block aria-busy:opacity-50 transition-opacity" do %>
  <% if !@listing.success? %>
    <p role="alert" class="rounded-md border border-red-900 bg-red-950/40 px-3 py-2 text-sm text-red-300">
      CI box unreachable: <%= @listing.error %>
    </p>
  <% elsif @ci_names.empty? %>
    <p class="text-sm italic text-neutral-500">No managed app has a GitHub origin yet. Run a scan to pick up CI names.</p>
  <% else %>
    <ul class="flex flex-wrap gap-2">
      <% @ci_names.each do |ci_name| %>
        <li id="latest_ci_<%= ci_name %>">
          <% if (run = @latest_runs[ci_name]) %>
            <%= link_to ci_run_path(run.id), data: { turbo_frame: "_top" },
                  class: "flex items-center gap-2 rounded-md border border-neutral-800 px-3 py-1.5 text-sm text-neutral-200 hover:bg-neutral-900" do %>
              <%= ci_name %> <%= ci_state_pill(run) %>
              <% if run.started_at %><span class="text-xs text-neutral-500"><%= ci_ago(run.started_at) %></span><% end %>
            <% end %>
          <% else %>
            <span class="flex items-center gap-2 rounded-md border border-neutral-900 px-3 py-1.5 text-sm text-neutral-500">
              <%= ci_name %> <span class="italic">no recent runs</span>
            </span>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
  <%= link_to "Reload", latest_ci_runs_path, class: "mt-2 inline-block text-xs text-neutral-500 hover:text-neutral-300" %>
<% end %>
