<% content_for :title, "Settings" %>

<section class="w-full max-w-md">
  <h1 class="mb-6 text-xl font-semibold text-neutral-100">Settings</h1>

  <%= form_with model: @setting, url: setting_path, method: :patch, class: "flex flex-col gap-4" do |form| %>
    <div>
      <%= form.label :scan_root, class: "mb-1 block text-sm text-neutral-400" %>
      <%= form.text_field :scan_root,
            class: "w-full rounded-md border border-neutral-700 bg-neutral-900 px-3 py-2 text-sm text-neutral-100" %>
    </div>

    <div>
      <%= form.label :default_ssh_user, class: "mb-1 block text-sm text-neutral-400" %>
      <%= form.text_field :default_ssh_user,
            class: "w-full rounded-md border border-neutral-700 bg-neutral-900 px-3 py-2 text-sm text-neutral-100" %>
    </div>

    <div>
      <%= form.label :ci_host, "CI host", class: "mb-1 block text-sm text-neutral-400" %>
      <%= form.text_field :ci_host, aria: { describedby: "ci_host_hint" },
            class: "w-full rounded-md border border-neutral-700 bg-neutral-900 px-3 py-2 text-sm text-neutral-100" %>
      <p id="ci_host_hint" class="mt-1 text-xs text-neutral-500">Leave blank to hide the CI panel.</p>
    </div>

    <div>
      <%= form.label :ci_user, "CI user", class: "mb-1 block text-sm text-neutral-400" %>
      <%= form.text_field :ci_user,
            class: "w-full rounded-md border border-neutral-700 bg-neutral-900 px-3 py-2 text-sm text-neutral-100" %>
    </div>

    <div>
      <label class="flex items-center gap-2 text-sm text-neutral-300">
        <%= form.check_box :kamal_verbs_enabled, aria: { describedby: "kamal_verbs_hint" } %>
        Reboot, start and stop from here
      </label>
      <p id="kamal_verbs_hint" class="mt-1 text-xs text-neutral-500">These run each app's bin/kamal, which needs its production secrets on this machine. Turn off where they aren't.</p>
    </div>

    <div>
      <label class="flex items-center gap-2 text-sm text-neutral-300">
        <%= form.check_box :pull_before_scan, aria: { describedby: "pull_before_scan_hint" } %>
        Pull repos before each scan
      </label>
      <p id="pull_before_scan_hint" class="mt-1 text-xs text-neutral-500">git pull --ff-only in each repo under the scan root. Only for clones Kamander owns, never your working repos.</p>
    </div>

    <%= form.submit "Save",
          class: "self-start rounded-md bg-neutral-100 px-4 py-2 text-sm font-medium text-neutral-900 hover:bg-white" %>
  <% end %>
</section>
